<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <AssemblyTitle>NotePad Launcher</AssemblyTitle>
    <Product>NotePad Launcher</Product>
    <Company>Verluer</Company>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\app.ico" />
    <None Remove="Resources\FolderAdd.png" />
    <None Remove="Resources\Locales\en.json" />
    <None Remove="Resources\Locales\ru.json" />
    <None Remove="Resources\Locales\ua.json" />
    <None Remove="Resources\Svg\Explorer.svg" />
    <None Remove="Resources\Svg\FileUpdate.svg" />
    <None Remove="Resources\Svg\FolderAdd.svg" />
    <None Remove="Resources\Svg\FolderDelete.svg" />
    <None Remove="Resources\Svg\FolderEdit.svg" />
    <None Remove="Resources\Svg\Refresh.svg" />
    <None Remove="Resources\Svg\TxtFileAdd.svg" />
    <None Remove="Resources\TxtFileAdd.png" />
  </ItemGroup>

  <ItemGroup>
    <Page Remove="Resources\Style.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.8" />
    <PackageReference Include="SharpVectors" Version="1.8.5" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
    <PackageReference Include="WindowsAPICodePack" Version="8.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\Domain.csproj" />
    <ProjectReference Include="..\Service\Service.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
    <Content Include="Resources\Locales\en.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Locales\ru.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Locales\ua.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Resource Include="Resources\Style.xaml" />
    <Resource Include="Resources\Svg\Explorer.svg" />
    <Resource Include="Resources\Svg\FileUpdate.svg" />
    <Resource Include="Resources\Svg\FolderAdd.svg" />
    <Resource Include="Resources\Svg\FolderDelete.svg" />
    <Resource Include="Resources\Svg\FolderEdit.svg" />
    <Resource Include="Resources\Svg\Refresh.svg" />
    <Resource Include="Resources\Svg\TxtFileAdd.svg" />
  </ItemGroup>

</Project>
