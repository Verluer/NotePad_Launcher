<Window x:Class="NotePad_Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NotePad_Launcher"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Style="{StaticResource MyWindowStyle}">

    <Grid x:Name="MainWindowContainer">
        <!--Разделение программы на ряды и столбцы-->
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="15" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="25"/>
        </Grid.ColumnDefinitions>
        <!--Подгрузка заголовка из App.xaml-->
        <ContentControl Content="{StaticResource MainHeadLine}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"/>
        <!--Меню кнопок под заголовком-->
        <DockPanel Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" Background="#F0F0F0" LastChildFill="False">
            <Menu DockPanel.Dock="Left" Background="#F0F0F0" VerticalAlignment="Center" Width="Auto">
                <MenuItem Header="Файл" Height="25" FontSize="14" VerticalAlignment="Center" >
                    <MenuItem Header="Создать" Height="25" FontSize="14" VerticalAlignment="Center"/>
                    <MenuItem Header="Открыть" Height="25" FontSize="14" VerticalAlignment="Center"/>
                    <MenuItem Header="Сохранить" Height="25" FontSize="14" VerticalAlignment="Center"/>
                    <MenuItem Header="Список файлов" Height="25" FontSize="14" VerticalAlignment="Center"/>
                </MenuItem>
            </Menu>
            <Menu DockPanel.Dock="Right" Background="#F0F0F0" VerticalAlignment="Center" Width="Auto">
                <MenuItem Header="Удалить Файл" Height="25" FontSize="14" VerticalAlignment="Center"/>
            </Menu>
        </DockPanel>
        <!--Текстовой обьект для именования файлов-->
        <TextBox Grid.Column="1" Grid.Row="2" x:Name="NameTextBox" />
        <!--Текстовой обьект для вывода текста из файла-->
        <RichTextBox Grid.Column="1" Grid.Row="3" x:Name="TextRichTextBox" />
        <!--Canvas панели (две боковые и одна нижняя) для дизайна программы-->
        <Canvas Grid.Row="2" Grid.Column="0" Grid.RowSpan="2" Background="#F0F0F0" />
        <Canvas Grid.Row="2" Grid.Column="3" Grid.RowSpan="2" Background="#F0F0F0" />
        <Canvas Grid.Column="0" Grid.Row="4"  Grid.ColumnSpan="3" Background="Gray" />
        <!--#######################################################################################-->
    </Grid>
</Window>
