<Window x:Class="NotePad_Launcher.MVVM.FontPickerDialog.FontPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NotePad_Launcher.MVVM.FontPickerDialog"
        mc:Ignorable="d"
        Title="FontPickerDialog" Height="400" Width="450"
        MaxWidth="450" MaxHeight="400" MinHeight="400" MinWidth="450"
    Style="{StaticResource WindowStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="150" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="80"/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="4" Background="{StaticResource HeadColor}" LastChildFill="false" Height="30"  MouseDown="HeadLine_MouseDown">
            <TextBlock Text=" Font" DockPanel.Dock="Left" FontSize="16" Foreground="WhiteSmoke" Height="26"/>
            <Button DockPanel.Dock="Right" Command="{Binding CloseCommand}" Content="✖">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ButtonHeadStyle}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="Red"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DockPanel>
        <StackPanel Grid.Column="0" Grid.Row="1" VerticalAlignment="Bottom">
            <TextBlock Text="Font" Height="20" Width="160"/>
            <TextBox Text="{Binding SelectedFont, Mode=TwoWay}" Height="20" Width="160"/>
            <ListBox VerticalAlignment="Bottom" HorizontalAlignment="Center" Height="80" Width="160" ItemsSource="{Binding Fonts}" SelectedItem="{Binding SelectedFont, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Grid.Row="1" VerticalAlignment="Bottom">
            <TextBlock Text="Font Style" Height="20" Width="120"/>
            <TextBox Text="{Binding SelectedFontStyle, Mode=TwoWay}"  Height="20" Width="120"/>
            <ListBox VerticalAlignment="Bottom" HorizontalAlignment="Center" Height="80" Width="120" ItemsSource="{Binding FontStyles}" SelectedItem="{Binding SelectedFontStyle, Mode=TwoWay}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Grid.Row="1" VerticalAlignment="Bottom">
            <TextBlock Text="Size" Height="20" Width="50"/>
            <TextBox Text="{Binding SelectedFontSize, Mode=TwoWay}" Height="20" Width="50"/>
            <ListBox  HorizontalAlignment="Center" Height="80" Width="50" ItemsSource="{Binding FontSizes}" SelectedItem="{Binding SelectedFontSize, Mode=TwoWay}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Text="AAAbbbbлллл" FontSize="{Binding SelectedFontSize}" FontFamily="{Binding SelectedFont}"/>
        <Button Grid.Column="1" Grid.Row="3" Command="{Binding ConfirmCommand}" Margin="0,0,15,0" HorizontalAlignment="Right" VerticalAlignment="Center" Height="20" Width="60" Background="Gainsboro">
            Ok
        </Button>
        <Button Grid.Column="2" Grid.Row="3" Command="{Binding CloseCommand}" HorizontalAlignment="Left" VerticalAlignment="Center" Height="20" Width="60" Background="Gainsboro">
            Отмена
        </Button>
    </Grid>
</Window>
