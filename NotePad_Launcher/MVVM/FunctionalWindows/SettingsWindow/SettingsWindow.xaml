<Window x:Class="NotePad_Launcher.MVVM.FunctionalWindows.SettingsWindow.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NotePad_Launcher.MVVM.FunctionalWindows.SettingsWindow"
        xmlns:commands="clr-namespace:NotePad_Launcher.MVVM.Commands"
        xmlns:enum="clr-namespace:Domain.Enum;assembly=Domain"
        mc:Ignorable="d"
        Title="SettingsWindow" Height="450" Width="500" MaxHeight="450" MinHeight="450" MaxWidth="500" MinWidth="500"
        Style="{StaticResource WindowStyle}">
    <Window.Resources>
        <commands:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <commands:OptionToBoolConverter x:Key="OptionToBoolConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="15" />
            <RowDefinition Height="*" />
            <RowDefinition Height="55" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="5" Background="{StaticResource HeadColor}" LastChildFill="false" Height="30"  MouseDown="HeadLine_MouseDown">
            <Image DockPanel.Dock="Left"  HorizontalAlignment="Center" VerticalAlignment="Center" Height="25" Source="../../Resources/app.ico"/>
            <TextBlock Text=" Settings" DockPanel.Dock="Left" FontSize="16" Foreground="WhiteSmoke" Height="26"/>
            <Button DockPanel.Dock="Right" Command="{Binding CloseCommand}" Content="✖">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ButtonHeadStyle}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="Red"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button DockPanel.Dock="Right" Command="{Binding MinimizeCommand}" Content="━" Style="{StaticResource ButtonHeadStyle}"/>
        </DockPanel>
        <Border Grid.Row="2" Grid.Column="1" CornerRadius="5" Background="#f0f0f0" BorderBrush="Gray" BorderThickness="1" Padding="0">
            <StackPanel>
                <RadioButton Content="Общее" GroupName="ButtonSettings" Style="{StaticResource RoundedRadioButtonStyle}"  IsChecked="{Binding SelectedSettings, Converter={StaticResource OptionToBoolConverter}, ConverterParameter=General}" />
                <RadioButton Content="Проверка" GroupName="ButtonSettings" Style="{StaticResource RoundedRadioButtonStyle}"  IsChecked="{Binding SelectedSettings, Converter={StaticResource OptionToBoolConverter}, ConverterParameter=Test}"  />
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Column="3" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Основные параметры" FontSize="16" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <DockPanel LastChildFill="True" Margin="0,10,0,0">
                    <TextBlock Text="Document&#x0a;Directory:   " DockPanel.Dock="Left" VerticalAlignment="Center" />
                    <TextBox Text="{Binding TextBoxDocumentDirect, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0" VerticalAlignment="Center" Width="230" MaxWidth="230"/>
                    <Button Command="{Binding OpenFolderCommand}" HorizontalAlignment="Right" Height="20" Width="20" Margin="0,0,5,0">
                        …
                    </Button>
                </DockPanel>
                <RadioButton Content="Сохранять файлы в директорию" GroupName="ButtonSettings" IsChecked="{Binding SelectedSaveConf, Converter={StaticResource OptionToBoolConverter}, ConverterParameter=SaveDirectory}" Margin="0,5,0,0"/>
                <RadioButton Content="Сохранять файлы по пути открытия" GroupName="ButtonSettings" IsChecked="{Binding SelectedSaveConf, Converter={StaticResource OptionToBoolConverter}, ConverterParameter=SaveNormal}" Margin="0,5,0,0"/>
                <StackPanel.Visibility>
                    <Binding Path="IsStackPanelGeneralVisible"  Converter="{StaticResource BoolToVisibilityConverter}" />
                </StackPanel.Visibility>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Column="3" Grid.Row="3" Command="{Binding SaveCommand}" Margin="0,0,70,0" HorizontalAlignment="Right" VerticalAlignment="Center" Height="20" Width="60" Background="Gainsboro">
            Save
        </Button>
        <Button Grid.Column="3" Grid.Row="3" Command="{Binding CloseCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Height="20" Width="60" Background="Gainsboro">
            Отмена
        </Button>
        
    </Grid>
</Window>
