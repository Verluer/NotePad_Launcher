<Window x:Class="NotePad_Launcher.MVVM.FunctionalWindows.FindReplaceWindow.FindReplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NotePad_Launcher.ServiceUI"
        xmlns:commands="clr-namespace:NotePad_Launcher.MVVM.Commands"
        mc:Ignorable="d"
        Title="{Binding TitleMethod}" Height="150" Width="400"
        MinWidth="400" MinHeight="150" MaxWidth="400" MaxHeight="150"
        Style="{StaticResource WindowStyle}">
    <Window.Resources>
        <commands:BoolToStringConverter x:Key="BoolToStringConverter" />
        <commands:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <ObjectDataProvider x:Key="LocService" ObjectType="{x:Type local:LocalizationService}" MethodName="get_Instance" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Background="{StaticResource HeadColor}" LastChildFill="false" Height="30"  MouseDown="HeadLine_MouseDown">
            <TextBlock Text="{Binding TitleMethod}" DockPanel.Dock="Left" FontSize="16" Foreground="WhiteSmoke" Height="26"/>
            <Button DockPanel.Dock="Right" Command="{Binding CloseCommand}" Content="✖">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ButtonHeadStyle}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="Red"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button DockPanel.Dock="Right" Command="{Binding MinimizeCommand}" Content="━" Style="{StaticResource ButtonHeadStyle}"/>
        </DockPanel>
        <TextBlock Grid.Column="0" Grid.Row="1" Text="{Binding Source={StaticResource LocService}, Path=[FindReplaceTextBlock1]}" FontSize="14" Height="20" VerticalAlignment="Center" Margin="5,0,0,0"/>
        <TextBox Text="{Binding SearchPattern, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center" Height="18" Width="250" MaxWidth="250" MaxHeight="18" VerticalAlignment="Center" Margin="35,0,0,0" />
        <TextBlock Grid.Column="0" Grid.Row="2" Text="{Binding Source={StaticResource LocService}, Path=[FindReplaceTextBlock2]}" FontSize="14" Height="20" VerticalAlignment="Top" Margin="5,0,0,0">
            <TextBlock.Visibility>
                <Binding Path="IsTextBlockReplaceVisible"  Converter="{StaticResource BoolToVisibilityConverter}" />
            </TextBlock.Visibility>
        </TextBlock>
        <TextBox Text="{Binding ReplacePattern, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Center" Height="18" Width="250" MaxWidth="250" MaxHeight="18" VerticalAlignment="Top" Margin="35,0,0,0" >
            <TextBox.Visibility>
                <Binding Path="IsTextBoxReplaceVisible"  Converter="{StaticResource BoolToVisibilityConverter}" />
            </TextBox.Visibility>
        </TextBox>
        <StackPanel Grid.Column="2" Grid.Row="1" Grid.RowSpan="2" Margin="0,10,0,0">
            <Button Content="{Binding Source={StaticResource LocService}, Path=[FindReplaceButtonFind]}" Command="{Binding SearchCommand}" FontSize="12" Height="22" Width="75"/>
            <Button Content="{Binding Source={StaticResource LocService}, Path=[FindReplaceButtonReplace]}" Command="{Binding ReplaceCommand}" FontSize="12" Height="22" Width="75" Margin="0,5,0,0">
                <Button.Visibility>
                    <Binding Path="IsButtonReplaceVisible"  Converter="{StaticResource BoolToVisibilityConverter}" />
                </Button.Visibility>
            </Button>
            <Button Content="{Binding Source={StaticResource LocService}, Path=[FindReplaceButtonReplaceAll]}" Command="{Binding ReplaceAllCommand}" FontSize="12" Height="22" Width="75" Margin="0,5,0,0">
                <Button.Visibility>
                    <Binding Path="IsButtonReplaceAllVisible"  Converter="{StaticResource BoolToVisibilityConverter}" />
                </Button.Visibility>
            </Button>
            <Button Content="{Binding Source={StaticResource LocService}, Path=[FindReplaceButtonCancel]}" Command="{Binding CloseCommand}" FontSize="12" Height="22" Width="75" Margin="{Binding ButtonCloseMargin}"/>
        </StackPanel>
        <DockPanel Grid.Column="1" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,15">
            <RadioButton Content="{Binding Source={StaticResource LocService}, Path=[FindReplaceRadioButtonUp]}" VerticalAlignment="Center" IsChecked="{Binding SelectedOption, Converter={StaticResource BoolToStringConverter}, ConverterParameter=Up}" Margin="0,0,10,0">
                <RadioButton.Visibility>
                    <Binding Path="IsRadioButtonUpVisible"  Converter="{StaticResource BoolToVisibilityConverter}" />
                </RadioButton.Visibility>
            </RadioButton>
            <RadioButton Content="{Binding Source={StaticResource LocService}, Path=[FindReplaceRadioButtonDown]}" VerticalAlignment="Center" IsChecked="{Binding SelectedOption, Converter={StaticResource BoolToStringConverter}, ConverterParameter=Down}">
                <RadioButton.Visibility>
                    <Binding Path="IsRadioButtonDownVisible"  Converter="{StaticResource BoolToVisibilityConverter}" />
                </RadioButton.Visibility>
            </RadioButton>
        </DockPanel>
        <StackPanel  Grid.Column="0" Grid.Row="2" VerticalAlignment="Bottom">
            <CheckBox Content="{Binding Source={StaticResource LocService}, Path=[FindReplaceCheckBoxRegisterAware]}" IsChecked="{Binding IsRegisterAware, Mode=TwoWay}" Margin="5,0,0,5"/>
            <CheckBox Content="{Binding Source={StaticResource LocService}, Path=[FindReplaceCheckBoxWrapAround]}" IsChecked="{Binding IsTextFairing, Mode=TwoWay}" Margin="5,0,0,5"/>
        </StackPanel>
    </Grid>
</Window>