<Window x:Class="NotePad_Launcher.MVVM.FunctionalWindows.SearchWindow.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NotePad_Launcher.MVVM.FunctionalWindows.SearchWindow"
        xmlns:commands="clr-namespace:NotePad_Launcher.MVVM.Commands"
        mc:Ignorable="d"
        Title="SearchWindow" Height="150" Width="400"
        MinWidth="400" MinHeight="150" MaxWidth="400" MaxHeight="150"
        Style="{StaticResource WindowStyle}">
    <Window.Resources>
        <commands:OptionToBoolConverter x:Key="OptionToBoolConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Background="{StaticResource HeadColor}" LastChildFill="false" Height="30"  MouseDown="HeadLine_MouseDown">
            <TextBlock Text=" Search" DockPanel.Dock="Left" FontSize="16" Foreground="WhiteSmoke" Height="26"/>
            <Button DockPanel.Dock="Right" Command="{Binding CloseCommand}" Content="✖">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ButtonHeadStyle}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="Red"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button DockPanel.Dock="Right" Command="{Binding MinimizeCommand}" Content="━" Style="{StaticResource ButtonHeadStyle}"/>
        </DockPanel>
        <TextBlock Grid.Column="0" Grid.Row="1" Text=" Что:" FontSize="14" Height="20" VerticalAlignment="Center"/>
        <TextBox Text="{Binding SearchPattern, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center" Height="18" Width="250" MaxWidth="250" MaxHeight="18" VerticalAlignment="Center" Margin="30,0,0,0" />
        <StackPanel Grid.Column="2" Grid.Row="1" Grid.RowSpan="2" Margin="0,10,0,0">
            <Button Content="Найти далее" Command="{Binding SearchCommand}" FontSize="12" Height="22" Width="75"/>
            <Button Content="Отмена" Command="{Binding CloseCommand}" FontSize="12" Height="22" Width="75" Margin="0,10,0,0"/>
        </StackPanel>
        <DockPanel Grid.Column="1" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,15">
            <RadioButton Content="Вверх" VerticalAlignment="Center" IsChecked="{Binding SelectedOption, Converter={StaticResource OptionToBoolConverter}, ConverterParameter=Up}" Margin="0,0,10,0"/>
            <RadioButton Content="Вниз" VerticalAlignment="Center" IsChecked="{Binding SelectedOption, Converter={StaticResource OptionToBoolConverter}, ConverterParameter=Down}"/>
        </DockPanel>
    </Grid>
</Window>
