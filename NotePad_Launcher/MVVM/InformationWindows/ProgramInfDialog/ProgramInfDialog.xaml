<Window x:Class="NotePad_Launcher.MVVM.ProgramInfDialog.ProgramInfDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NotePad_Launcher.MVVM.ProgramInfDialog"
        mc:Ignorable="d"
        Title="ProgramInfDialog" Height="400" Width="450"
        MaxWidth="450" MaxHeight="400" MinHeight="400" MinWidth="450"
        Style="{StaticResource WindowStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="55"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="25"/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Background="{StaticResource HeadColor}" LastChildFill="false" Height="30"  MouseDown="HeadLine_MouseDown">
            <TextBlock Text=" Program Information" DockPanel.Dock="Left" FontSize="16" Foreground="WhiteSmoke" Height="26"/>
            <Button DockPanel.Dock="Right" Command="{Binding CloseCommand}" Content="✖">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ButtonHeadStyle}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="Red"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DockPanel>
        <Image Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top" Height="30" Source="../../Resources/app.ico"/>
        <TextBlock Grid.Column="1" Grid.Row="2" MaxWidth="300" Width="300" TextWrapping="Wrap" HorizontalAlignment="Center" >
            Название: NotePad Launcher
            <LineBreak />
            Версия: Alpha
            <LineBreak />
            Разработчик: Verluer
            <LineBreak />
            Дата создания: 24.03.2025
            <LineBreak />
            <LineBreak />
            Данное приложение было создано исключительно в практических целях для изучения и отработки навыков программирования.
            Оно не предназначено для коммерческого использования и распространя-ется "как есть" без каких-либо гарантий.
            <LineBreak />
            <LineBreak />
            Все права на код и алгоритмы принадлежат автору.

        </TextBlock>
        <Button Grid.Column="1" Grid.Row="3" Command="{Binding CloseCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Height="20" Width="60" Background="Gainsboro">
            Ok
        </Button>
    </Grid>
</Window>
