<Window x:Class="NotePad_Launcher.MVVM.ProgramInfDialog.ProgramInfDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NotePad_Launcher.ServiceUI"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="400" Width="450"
        MaxWidth="450" MaxHeight="400" MinHeight="400" MinWidth="450"
        Style="{StaticResource WindowStyle}">
    <Window.Resources>
        <ObjectDataProvider x:Key="LocService" ObjectType="{x:Type local:LocalizationService}" MethodName="get_Instance" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="55"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="25"/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Background="{StaticResource HeadColor}" LastChildFill="false" Height="30"  MouseDown="HeadLine_MouseDown">
            <TextBlock Text="{Binding Title}" DockPanel.Dock="Left" FontSize="16" Foreground="WhiteSmoke" Height="26"/>
            <Button DockPanel.Dock="Right" Command="{Binding CloseCommand}" Content="✖">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ButtonHeadStyle}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="Red"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DockPanel>
        <Image Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top" Height="30" Source="pack://application:,,,/NotePad_Launcher;component/Resources/app.ico"/>
        <TextBlock Text="{Binding Source={StaticResource LocService}, Path=[ProgramInfAboutText]}" Grid.Column="1" Grid.Row="2" MaxWidth="300" Width="300" TextWrapping="Wrap" xml:space="preserve" HorizontalAlignment="Center" />

        <Button Grid.Column="1" Grid.Row="3" Command="{Binding CloseCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Height="20" Width="60" Background="Gainsboro">
            Ok
        </Button>
    </Grid>
</Window>
