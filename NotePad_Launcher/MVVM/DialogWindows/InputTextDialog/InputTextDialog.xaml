<Window x:Class="NotePad_Launcher.MVVM.DialogWindows.InputTextDialog.InputTextDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NotePad_Launcher.MVVM.DialogWindows.InputTextDialog"
        xmlns:commands="clr-namespace:NotePad_Launcher.MVVM.Commands"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="150" Width="350" MaxWidth="350" MaxHeight="150" MinHeight="150" MinWidth="350" 
        Style="{StaticResource WindowStyle}">
    <Window.Resources>
        <commands:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="80"/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Background="{StaticResource HeadColor}" LastChildFill="false" Height="30"  MouseDown="HeadLine_MouseDown">
            <TextBlock Text="{Binding Title}" DockPanel.Dock="Left" FontSize="16" Foreground="WhiteSmoke" Height="26"/>
            <Button DockPanel.Dock="Right" Command="{Binding CloseCommand}" Content="✖">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ButtonHeadStyle}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="Red"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DockPanel>
        <TextBlock Text="{Binding Message}" Grid.Row="1" Grid.ColumnSpan="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBox Text="{Binding InputText}" Grid.Row="2" Grid.ColumnSpan="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="200">
            <TextBox.Visibility>
                <Binding Path="IsTextBoxVisible"  Converter="{StaticResource BoolToVisibilityConverter}" />
            </TextBox.Visibility>
        </TextBox>
        <ComboBox Grid.Row="2" Grid.ColumnSpan="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="200" ItemsSource="{Binding FolderFileString}" SelectedItem="{Binding SelectedFolder}"  SelectedIndex="{Binding SelectedIndex}">
            <ComboBox.Visibility>
                <Binding Path="IsComboBoxVisible"  Converter="{StaticResource BoolToVisibilityConverter}" />
            </ComboBox.Visibility>
        </ComboBox>
        <Button Content="Ok" Command="{Binding OkCommand}" Grid.Row="3" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center" Width="50" Margin="0,0,15,0"/>
        <Button Content="Cancel" Command="{Binding CancelCommand}" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Width="50"/>
    </Grid>
</Window>
