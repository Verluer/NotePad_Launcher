<Window x:Class="NotePad_Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:enum="clr-namespace:Domain.Enum;assembly=Domain"
        xmlns:local="clr-namespace:NotePad_Launcher.ServiceUI"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Title="NotePad Launcher" Height="450" Width="800"
        MinWidth="300" MinHeight="200"
        Style="{StaticResource WindowStyle}">
    <Window.Resources>
        <ObjectDataProvider x:Key="LocService" ObjectType="{x:Type local:LocalizationService}" MethodName="get_Instance" />
    </Window.Resources>
    <Grid x:Name="MainWindowContainer">
        <!--Разделение программы на ряды и столбцы-->
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="15" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="25"/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Background="{StaticResource HeadColor}" LastChildFill="false" Height="30"  MouseDown="HeadLine_MouseDown">
            <Image DockPanel.Dock="Left"  HorizontalAlignment="Center" VerticalAlignment="Center" Height="25" Source="pack://application:,,,/NotePad_Launcher;component/Resources/app.ico"/>
            <TextBlock Text=" NotePad Launcher" DockPanel.Dock="Left" FontSize="16" Foreground="WhiteSmoke" Height="26"/>
            <Button DockPanel.Dock="Right" Command="{Binding CloseCommand}" Content="✖">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ButtonHeadStyle}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="Red"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button DockPanel.Dock="Right" Command="{Binding MaximizeCommand}" Content="⛶" Style="{StaticResource ButtonHeadStyle}"/>
            <Button DockPanel.Dock="Right" Command="{Binding MinimizeCommand}" Content="━" Style="{StaticResource ButtonHeadStyle}"/>
        </DockPanel>
        <!--Меню кнопок под заголовком-->
        <DockPanel Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" Background="#F0F0F0" LastChildFill="False">
            <Menu DockPanel.Dock="Left" Background="#F0F0F0" VerticalAlignment="Center" Width="Auto">
                <MenuItem Header="{Binding Source={StaticResource LocService}, Path=[MainMenuItemFile]}" Style="{StaticResource MainWindowMenuItemStyle}">
                    <MenuItem Command="{Binding CreateFileCommand}"  Header="{Binding Source={StaticResource LocService}, Path=[MainMenuItemFileCreate]}" Style="{StaticResource MainWindowMenuItemStyle}"/>
                    <MenuItem Command="{Binding OpenFileCommand}" Header="{Binding Source={StaticResource LocService}, Path=[MainMenuItemFileOpen]}" Style="{StaticResource MainWindowMenuItemStyle}"/>
                    <MenuItem Command="{Binding SaveFileCommand}" Header="{Binding Source={StaticResource LocService}, Path=[MainMenuItemFileSave]}" Style="{StaticResource MainWindowMenuItemStyle}"/>
                    <MenuItem Command="{Binding SaveFileDialogCommand}" Header="{Binding Source={StaticResource LocService}, Path=[MainMenuItemFileSaveDialog]}" Style="{StaticResource MainWindowMenuItemStyle}"/>
                    <MenuItem Command="{Binding FileListCommand}" Header="{Binding Source={StaticResource LocService}, Path=[MainMenuItemFileList]}" Style="{StaticResource MainWindowMenuItemStyle}"/>
                    <MenuItem Command="{Binding DeleteFileCommand}" Header="{Binding Source={StaticResource LocService}, Path=[MainMenuItemFileDelete]}" Style="{StaticResource MainWindowMenuItemStyle}"/>
                </MenuItem>
                <MenuItem Header="{Binding Source={StaticResource LocService}, Path=[MainMenuItemEdit]}" Style="{StaticResource MainWindowMenuItemStyle}">
                    <MenuItem Command="{Binding SearchPatternCommand}" CommandParameter="{x:Static enum:FindReplaceMethod.Find}" Header="{Binding Source={StaticResource LocService}, Path=[MainMenuItemEditSearch]}" Style="{StaticResource MainWindowMenuItemStyle}"/>
                    <MenuItem Command="{Binding SearchPatternCommand}" CommandParameter="{x:Static enum:FindReplaceMethod.Replace}" Header="{Binding Source={StaticResource LocService}, Path=[MainMenuItemEditReplace]}" Style="{StaticResource MainWindowMenuItemStyle}"/>
                    <MenuItem Command="{Binding ClearCommand}" CommandParameter="{x:Static enum:FindReplaceMethod.Replace}" Header="{Binding Source={StaticResource LocService}, Path=[MainMenuItemEditClear]}" Style="{StaticResource MainWindowMenuItemStyle}"/>
                </MenuItem>
                <MenuItem Header="{Binding Source={StaticResource LocService}, Path=[MainMenuItemFormat]}" Style="{StaticResource MainWindowMenuItemStyle}" >
                    <MenuItem Command="{Binding ToggleWordWrapCommand}" IsChecked="{Binding IsWordWrapEnabled, Mode=TwoWay}" Header="{Binding Source={StaticResource LocService}, Path=[MainMenuItemFormatWordWrap]}" Style="{StaticResource MainWindowMenuItemStyle}"/>
                    <MenuItem Command="{Binding ToggleSyntaxHighlightingCommand}" IsChecked="{Binding IsSyntaxHighlightingEnabled, Mode=TwoWay}" Header="Syntax highlighting" Style="{StaticResource MainWindowMenuItemStyle}"/>
                    <MenuItem Command="{Binding FontPickerCommand}" Header="{Binding Source={StaticResource LocService}, Path=[MainMenuItemFormatFont]}" Style="{StaticResource MainWindowMenuItemStyle}"/>
                    <MenuItem Header="Encryption" Style="{StaticResource MainWindowMenuItemStyle}">
                        <MenuItem Command="{Binding EncryptedMethodCommand}" CommandParameter="{x:Static enum:EncryptionMethod.RSA}"  Header="RSA" Style="{StaticResource MainWindowMenuItemStyle}"/>
                        <MenuItem Command="{Binding EncryptedMethodCommand}" CommandParameter="{x:Static enum:EncryptionMethod.Elgamal}"  Header="Elgamal" Style="{StaticResource MainWindowMenuItemStyle}"/>
                        <MenuItem Command="{Binding EncryptedMethodCommand}" CommandParameter="{x:Static enum:EncryptionMethod.Rabina}"  Header="Rabina" Style="{StaticResource MainWindowMenuItemStyle}"/>
                        <MenuItem Command="{Binding EncryptedMethodCommand}" CommandParameter="{x:Static enum:EncryptionMethod.ECC}"  Header="ECC" Style="{StaticResource MainWindowMenuItemStyle}"/>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="{Binding Source={StaticResource LocService}, Path=[MainMenuItemHelp]}" Style="{StaticResource MainWindowMenuItemStyle}" >
                    <MenuItem Header="Github" Command="{Binding MovingGithubCommand}" Style="{StaticResource MainWindowMenuItemStyle}"/>
                    <MenuItem Header="{Binding Source={StaticResource LocService}, Path=[MainMenuItemHelpAbout]}" Command="{Binding ProgramInfCommand}" Style="{StaticResource MainWindowMenuItemStyle}"/>
                </MenuItem>
            </Menu>
            <Menu DockPanel.Dock="Right" Background="#F0F0F0" VerticalAlignment="Center" Width="Auto">
                <MenuItem Command="{Binding  LogCommand}" Header="⚙" Style="{StaticResource MainWindowMenuItemStyle}"/>
            </Menu>
        </DockPanel>
        <!--Текстовой обьект для именования файлов-->
        <TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"  Grid.Column="1" Grid.Row="2" TextAlignment="Center" FontSize="25"/>
        <!-- AvalonEdit -->
        <avalonEdit:TextEditor FontStyle="{Binding SelectedFontStyle,  FallbackValue=Normal}" FontWeight="{Binding SelectedFontWeight, FallbackValue=Normal}" FontSize="{Binding SelectedFontSize}" FontFamily="{Binding SelectedFontFamily}" Name="FileText" ShowLineNumbers="True" Grid.Column="1" Grid.Row="3" BorderBrush="Gray" BorderThickness="1"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <!--Canvas панели (две боковые и одна нижняя) для дизайна программы-->
        <Canvas Grid.Row="2" Grid.Column="0" Grid.RowSpan="2" Background="#F0F0F0" />
        <Canvas Grid.Row="2" Grid.Column="3" Grid.RowSpan="2" Background="#F0F0F0" />
        <Canvas Grid.Column="0" Grid.Row="4"  Grid.ColumnSpan="3" Background="Gray" />
        <!--#######################################################################################-->
    </Grid>
</Window>
