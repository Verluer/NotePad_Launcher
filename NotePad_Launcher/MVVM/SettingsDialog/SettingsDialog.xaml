<Window x:Class="NotePad_Launcher.MVVM.SettingsDialog.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NotePad_Launcher.MVVM.SettingsDialog"
        mc:Ignorable="d"
        Title="SettingsDialog" Height="650" Width="850"
        Style="{StaticResource WindowStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="100" />
            <RowDefinition Height="100" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource HeadColor}" LastChildFill="false" Height="30"  MouseDown="HeadLine_MouseDown">
            <TextBlock Text=" Settings" DockPanel.Dock="Left" FontSize="16" Foreground="WhiteSmoke" Height="26"/>
            <Button DockPanel.Dock="Right" Command="{Binding CloseCommand}" Content="✖">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ButtonHeadStyle}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="Red"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DockPanel>
        <TextBlock Grid.Column="1" Grid.Row="1" Text="Setting" FontSize="30" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <DockPanel Grid.Column="1" Grid.Row="2">
            <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Left" VerticalAlignment="Top" Text="DirectoryPath:" FontSize="18"/>
            <TextBox DockPanel.Dock="Left" MaxWidth="500" Width="500" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="18"/>
            <Button DockPanel.Dock="Top" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75" Height="25" FontSize="18" Content="Обзор" Margin="25,0"/>
        </DockPanel>
    </Grid>
</Window>
