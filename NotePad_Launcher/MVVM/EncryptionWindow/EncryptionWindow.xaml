<Window x:Class="NotePad_Launcher.EncryptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NotePad_Launcher"
        xmlns:viewModels="clr-namespace:NotePad_Launcher.ViewModels"
        mc:Ignorable="d"
        Title="EncryptionWindow" Height="400" Width="600"
        Style="{StaticResource MyWindowStyle}">
    <Window.Resources>
        <viewModels:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="50" />
            <RowDefinition Height="80" />
            <RowDefinition Height="80"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <!--Заголовок программы (Именование и три кнопки функционала)-->
        <DockPanel Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Background="#004C56" LastChildFill="False" Height="30" MouseDown="HeadLine_MouseDown">
            <!-- Текст слева -->
            <Menu DockPanel.Dock="Left" Background="#004C56">
                <MenuItem Header="HeaderName" IsEnabled="False">
                    <MenuItem.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="Encryption/Decryption App" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </MenuItem.HeaderTemplate>
                </MenuItem>
            </Menu>
            <!-- Кнопки справа -->
            <Menu DockPanel.Dock="Right" Background="#004C56">
                <MenuItem Height="30" Click="MinimizeApp_Click">
                    <MenuItem.Header>
                        <TextBlock Text="━" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem Height="30" Click="MaximizeApp_Click" >
                    <MenuItem.Header>
                        <TextBlock Text="⛶" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem Height="30" Click="CloseApp_Click">
                    <MenuItem.Header>
                        <TextBlock Text="✖" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </MenuItem.Header>
                </MenuItem>
            </Menu>
        </DockPanel>
        <TextBlock Text="{Binding MethodName}" Grid.Column="1" Grid.Row="1" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
        <StackPanel Grid.Column="0" Grid.Row="2" >
            <TextBlock  Text="{Binding TextBlockValue1}" x:Name="LabelText1" FontSize="20" HorizontalAlignment="Center"/>
            <TextBox Text="{Binding TextBoxValue1}" x:Name="TextValue1"  Width="100" Height="30"  FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
        </StackPanel>

        <StackPanel Grid.Column="0" Grid.Row="3" >
            <TextBlock  Text="{Binding TextBlockValue2}" x:Name="LabelText2" FontSize="20" HorizontalAlignment="Center">
                <TextBlock.Visibility>
                    <Binding Path="IsElement2Visible" Converter="{StaticResource BoolToVisibilityConverter}" />
                </TextBlock.Visibility>
            </TextBlock>
            <TextBox Text="{Binding TextBoxValue2}" x:Name="TextValue2" Width="100" Height="30" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                <TextBox.Visibility>
                    <Binding Path="IsElement2Visible"  Converter="{StaticResource BoolToVisibilityConverter}" />
                </TextBox.Visibility>
            </TextBox>
        </StackPanel>
        <StackPanel Grid.Column="0" Grid.Row="4" >
            <TextBlock  Text="{Binding TextBlockValue3}" x:Name="LabelText3" FontSize="20" HorizontalAlignment="Center">
                <TextBlock.Visibility>
                    <Binding Path="IsTextBlock3Visible" Converter="{StaticResource BoolToVisibilityConverter}" />
                </TextBlock.Visibility>
            </TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBox Text="{Binding TextBoxValue3}" x:Name="TextValue3" Width="50" Height="30" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="5">
                    <TextBox.Visibility>
                        <Binding Path="IsTextBoxValue3Visible"  Converter="{StaticResource BoolToVisibilityConverter}" />
                    </TextBox.Visibility>
                </TextBox>
                <TextBox Text="{Binding TextBoxValue4}" x:Name="TextValue4" Width="50" Height="30" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="5">
                    <TextBox.Visibility>
                        <Binding Path="IsTextBoxValue4Visible"  Converter="{StaticResource BoolToVisibilityConverter}" />
                    </TextBox.Visibility>
                </TextBox>
                <TextBox Text="{Binding TextBoxValue5}" x:Name="TextValue5" Width="50" Height="30" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="5">
                    <TextBox.Visibility>
                        <Binding Path="IsTextBoxValue5Visible"  Converter="{StaticResource BoolToVisibilityConverter}" />
                    </TextBox.Visibility>
                </TextBox>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Grid.Row="3" >
            <TextBlock  Text="{Binding TextBlockCloseKey}" x:Name="LabelEnKey" FontSize="20" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBox Text="{Binding TextBoxCloseKey1}" x:Name="CloseKey1" Width="50" Height="30" FontSize="20" VerticalAlignment="Center" Margin="5"/>
                <TextBox Text="{Binding TextBoxCloseKey2}" x:Name="CloseKey2" Width="50" Height="30" FontSize="20" VerticalAlignment="Center" Margin="5">
                    <TextBox.Visibility>
                        <Binding Path="IsTextBoxCloseKey2Visible"  Converter="{StaticResource BoolToVisibilityConverter}" />
                    </TextBox.Visibility>
                </TextBox>
                <TextBox Text="{Binding TextBoxCloseKey3}" x:Name="CloseKey3" Width="50" Height="30" FontSize="20" VerticalAlignment="Center" Margin="5">
                    <TextBox.Visibility>
                        <Binding Path="IsTextBoxCloseKey3Visible"  Converter="{StaticResource BoolToVisibilityConverter}" />
                    </TextBox.Visibility>
                </TextBox>
            </StackPanel>
        </StackPanel>
        <TextBlock  Grid.Column="2" Grid.Row="4" x:Name="LabelCloseKey"  Text="{Binding TextBlockCloseKey}" FontSize="20" HorizontalAlignment="Center"/>
        <TextBlock  Grid.Column="2" Grid.Row="4" x:Name="LabelOpenKey"  Text="{Binding TextBlockOpenKey}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
        <Button x:Name="EncryptionButton" Command="{Binding EncryptionCommand}"  Grid.Row="5" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="150" Height="50" FontSize="20">
            Encryption
        </Button>
        <Button Command="{Binding DigitalSignatureCommand}" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="150" Height="50" FontSize="20">
            Digital signature
        </Button>
        <Button Command="{Binding DecryptionCommand}" Grid.Row="5" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Width="150" Height="50" FontSize="20">
            Decryption
        </Button>
    </Grid>
</Window>
